# Configoration
NEXT_PUBLIC_SITE_URL= #site url (make sure to specify this unless you are using localhost)

# Sanity CMS configuration
NEXT_PUBLIC_SANITY_DATASET= #dataset name
NEXT_PUBLIC_SANITY_PROJECT_ID= #sanity cms project id
SANITY_READ_TOKEN= #sanity cms token
SANITY_REVALIDATE_SECRET= #shared secret of the Sanity webhook that hits /api/revalidate

# Studio writing checks (proofread and SEO feedback)
OPENROUTER_API_KEY= #openrouter.ai key, server-only; give it a credit limit

# Studio uploads to Cloudinary (signed on the server; the secret never reaches the browser)
CLOUDINARY_API_KEY= #cloudinary api key
CLOUDINARY_API_SECRET= #cloudinary api secret, server-only

# Optional
# NEXT_PUBLIC_PAGESPEED_KEY= #Google PageSpeed Insights key for the Studio's live SEO check; restrict it to the site's address
# ANALYZE=true # Enable to analyze bundle size
# NEXT_PUBLIC_SANITY_API_VERSION= #sanity api version
# ALLOWED_DEV_ORIGINS=192.168.0.10 # Comma-separated LAN hosts allowed to reach the dev server
